+def _transcode_to_wav(audio_file) -> str:
+    """Re-encode audio to 16 kHz mono WAV for OpenAI-compatible STT backends."""
+    source = getattr(audio_file, "name", None)
+    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tmp:
+        output_path = tmp.name
+
+    command = [
+        "ffmpeg",
+        "-y",
+        "-i",
+        str(source) if source else "pipe:0",
+        "-ac",
+        "1",
+        "-ar",
+        "16000",
+        output_path,
+    ]
+    try:
+        if source:
+            subprocess.run(command, check=True, capture_output=True)
+        else:
+            subprocess.run(
+                command, check=True, input=audio_file.read(), capture_output=True
+            )
+    except subprocess.CalledProcessError as exc:
+        os.remove(output_path)
+        stderr = (exc.stderr or b"").decode(errors="replace")
+        raise CorruptedAudioFile(f"ffmpeg failed: {stderr}") from exc
+    return output_path
+
